{% extends 'base.html.twig' %}

{% block title %}Catalogue - Liste des livres{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container px-4">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <h1 class="fw-bold text-primary mb-3">
                    <i class="fas fa-books me-2"></i>Catalogue des livres
                </h1>
                <p class="lead">Explorez notre collection complète de livres disponibles</p>
            </div>
        </div>

        {% if livres is defined and livres|length > 0 %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for livre in livres %}
                    <div class="col">
                        <div class="card h-100 shadow-sm book-card" style="background-image: url('{{ livre.image ?? 'https://picsum.photos/200/300?random=' ~ livre.id }}');">
                            <div class="card-body d-flex flex-column justify-content-end">
                                <h5 class="card-title">{{ livre.title }}</h5>
                                <p class="card-text mb-2">
                                    <i class="fas fa-user me-1"></i>
                                    {% for author in livre.authors %}
                                        {{ author.name }}{% if not loop.last %}, {% endif %}
                                    {% else %}
                                        <em>Auteur non renseigné</em>
                                    {% endfor %}
                                </p>
                                <p class="card-text mb-3">
                                    <i class="fas fa-building me-1"></i>{{ livre.editor ? livre.editor.name : 'Éditeur non renseigné' }}
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-white-50">
                                        <i class="fas fa-hashtag me-1"></i>{{ livre.isbn }}
                                    </small>
                                     <a href="{{ path('livre_detail', {'id': livre.id}) }}" class="btn btn-light btn-sm">
                                        <i class="fas fa-eye me-1"></i>Détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Pagination -->
            {% if totalPages > 1 %}
            <div class="d-flex justify-content-center mt-5">
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        {% if currentPage > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': currentPage - 1})) }}">Précédent</a>
                        </li>
                        {% else %}
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Précédent</a>
                        </li>
                        {% endif %}

                        {% for page in 1..totalPages %}
                            {% if page == currentPage %}
                            <li class="page-item active">
                                <a class="page-link" href="#">{{ page }}</a>
                            </li>
                            {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': page})) }}">{{ page }}</a>
                            </li>
                            {% endif %}
                        {% endfor %}

                        {% if currentPage < totalPages %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': currentPage + 1})) }}">Suivant</a>
                        </li>
                        {% else %}
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Suivant</a>
                        </li>
                        {% endif %}
                    </ul>
                </nav>
            </div>
            {% endif %}
        {% else %}
            <div class="text-center py-5">
                <i class="fas fa-book-open fa-5x text-muted mb-4"></i>
                <h3 class="text-muted">Aucun livre trouvé</h3>
                <p class="text-muted">Il n'y a actuellement aucun livre dans notre catalogue.</p>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
