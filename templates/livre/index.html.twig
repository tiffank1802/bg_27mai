{% extends 'base.html.twig' %}

{% block title %}Liste des livres{% endblock %}

{% block body %}
<div class="row row-cols-1 row-cols-md-3 g-4">
    {% for livre in livres %}
        <div class="col">
            <div class="card h-100">
                <img src="{{ livre.cover }}" class="card-img-top" alt="{{ livre.title }}">
                <div class="card-body">
                    <h5 class="card-title">{{ livre.title }}</h5>
                    <p class="card-text">
                        Auteur(s):
                        {% for author in livre.authors %}
                            {{ author.name }}{% if not loop.last %}, {% endif %}
                        {% else %}
                            <em>Non renseigné</em>
                        {% endfor %}
                    </p>
                    <p class="card-text">Éditeur: {{ livre.editor ? livre.editor.name : 'Non renseigné' }}</p>
                    <a href="{{ path('livre_detail', {'id': livre.id}) }}" class="btn btn-primary">Détails</a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
