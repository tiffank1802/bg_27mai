{% extends 'base.html.twig' %}

{% block title %}Connexion Administrateur{% endblock %}

{% block body %}
<style>
    .admin-login-container {
        max-width: 400px;
        margin: 5rem auto;
        padding: 2rem;
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .admin-login-header {
        text-align: center;
        margin-bottom: 2rem;
        color: #333;
    }
    .admin-login-header h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }
    .admin-login-header p {
        color: #666;
        font-size: 1.1rem;
    }
    .form-group {
        margin-bottom: 1.5rem;
    }
    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #333;
    }
    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #ddd;
        border-radius: 5px;
        font-size: 1rem;
        transition: border-color 0.3s;
    }
    .form-control:focus {
        outline: none;
        border-color: #007bff;
    }
    .btn-admin-login {
        width: 100%;
        padding: 0.75rem;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 1.1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.3s;
    }
    .btn-admin-login:hover {
        background: #c82333;
    }
    .alert {
        padding: 0.75rem;
        border-radius: 5px;
        margin-bottom: 1rem;
    }
    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    .back-link {
        text-align: center;
        margin-top: 1rem;
    }
    .back-link a {
        color: #007bff;
        text-decoration: none;
    }
    .back-link a:hover {
        text-decoration: underline;
    }
</style>

<div class="admin-login-container">
    <div class="admin-login-header">
        <h1>🔐 Connexion Administrateur</h1>
        <p>Entrez le code secret pour accéder au panneau d'administration</p>
    </div>

    {% if error %}
        <div class="alert alert-danger">
            {{ error }}
        </div>
    {% endif %}

    {% if success %}
        <div class="alert alert-success">
            {{ success }}
        </div>
        <script>
            setTimeout(function() {
                window.location.href = '{{ path('admin') }}';
            }, 2000);
        </script>
    {% endif %}

    <form method="post">
        <div class="form-group">
            <label for="admin_code">Code Secret</label>
            <input type="password"
                   id="admin_code"
                   name="admin_code"
                   class="form-control"
                   placeholder="Entrez le code secret"
                   required
                   autofocus>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_login') }}">

        <button type="submit" class="btn-admin-login">
            Se connecter en tant qu'Administrateur
        </button>
    </form>

    <div class="back-link">
        <a href="{{ path('app_login') }}">← Retour à la connexion normale</a>
    </div>
</div>
{% endblock %}